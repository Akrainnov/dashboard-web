# ==============================================================================
# CONFIGURATION SUPABASE — CAISSE ELECTRON (Compass Solution POS)
# ==============================================================================
# Copiez ce fichier sous le nom '.env' (exclu de Git par .gitignore).

# URL de votre projet Supabase (disponible dans Supabase > Settings > API)
SUPABASE_URL=https://rukilsmjfxxirddpojop.supabase.co/rest/v1/

# ⚠️ SÉCURITÉ : Clé 'service_role' (secrète) de Supabase pour la caisse locale.
# Cette clé permet à la caisse d'écrire en toute sécurité (upsert & purge de rétention).
# Elle réside UNIQUEMENT en local sur la caisse et ne doit JAMAIS être partagée
# ni intégrée dans le dashboard web public !
SUPABASE_SERVICE_ROLE_KEY=sb_secret_mkGlZrrEBbh1HqapeCAVrg_Gkt0qBBU

# (Alternative) Clé 'anon' si vous avez appliqué les règles RLS écriture pour anon :
# SUPABASE_KEY=votre_cle_anon_ici

# Intervalle de synchronisation en minutes (par défaut : 15 minutes)
SYNC_INTERVAL_MINUTES=15

# Identifiant unique de cette caisse
CAISSE_ID=caisse_principale
